#!/usr/bin/env python3
"""`ziggy`: starts Ziggy One for the current folder and opens the interface, already signed in.

The current folder becomes the default folder of new agents; the options of server.py still apply
(`ziggy --permission-mode auto`). If Ziggy One is already running, `ziggy` only opens the interface.
The token is never shown: the browser gets a single-use sign-in link.
"""

import sys
from pathlib import Path

if not sys.platform.startswith(("linux", "darwin")):
    sys.exit("ziggy: Ziggy One only runs on Linux and macOS for now (pty terminals).")
if sys.version_info < (3, 10):
    sys.exit("ziggy: Python 3.10 or newer is required.")

ROOT = Path(__file__).resolve().parent  # resolve: follows the ~/.local/bin/ziggy link
sys.path.insert(0, str(ROOT))
import server  # noqa: E402

sys.argv = [str(ROOT / "server.py"), "--open", *sys.argv[1:]]
server.main()
