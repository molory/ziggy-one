#!/usr/bin/env python3
"""`ziggy` : lance Ziggy One pour le dossier courant et ouvre l'interface, déjà connectée.

Le dossier courant devient le dossier par défaut des nouveaux agents ; les options de server.py restent
valables (`ziggy --permission-mode auto`). Si Ziggy One tourne déjà, `ziggy` ouvre seulement l'interface.
Le token ne s'affiche jamais : le navigateur reçoit un lien de connexion à usage unique.
"""

import sys
from pathlib import Path

if not sys.platform.startswith("linux"):
    sys.exit("ziggy : Ziggy One ne fonctionne que sous Linux pour l'instant (terminaux pty et setsid).")
if sys.version_info < (3, 10):
    sys.exit("ziggy : Python 3.10 ou plus récent est nécessaire.")

ROOT = Path(__file__).resolve().parent  # resolve : suit le lien de ~/.local/bin/ziggy
sys.path.insert(0, str(ROOT))
import server  # noqa: E402

sys.argv = [str(ROOT / "server.py"), "--open", *sys.argv[1:]]
server.main()
